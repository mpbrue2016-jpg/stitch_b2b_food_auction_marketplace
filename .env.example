# Supabase PostgreSQL & Auth
NEXT_PUBLIC_SUPABASE_URL=https://sua-instancia.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-publica-anon-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-chave-privada-service-role-aqui

# Google AI Studio (Modelos Gemini) - Somente no Backend
GEMINI_API_KEY=sua-chave-api-gemini-aqui

# Configurações da Aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=production
